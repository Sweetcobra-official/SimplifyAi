# IO_INTELLIGENCE_API_KEY: ОБЯЗАТЕЛЕН (MANDATORY).
# Основной API-ключ платформы IO Intelligence для маршрутизации и доступа к нейросетям.
IO_INTELLIGENCE_API_KEY=
VITE_IO_INTELLIGENCE_API_KEY=

# IO_INTELLIGENCE_BASE_URL: Базовый URL для API (по умолчанию: https://api.intelligence.io.solutions/api/v1).
IO_INTELLIGENCE_BASE_URL="https://api.intelligence.io.solutions/api/v1"

# GEMINI_API_KEY: НЕОБЯЗАТЕЛЕН (OPTIONAL).
# Резервный шлюз отказоустойчивости при недоступности внешних узлов.
GEMINI_API_KEY=""

# APP_URL: URL приложения для обратных вызовов и эндпоинтов.
APP_URL="MY_APP_URL"

